<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Pump seal-in]]>
</Comment>
<Text>
<![CDATA[[XIC(Start_PB) ,XIC(Pump) ]XIO(Stop_PB)OTE(Pump);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GRT(Level,80.0)TON(HighTmr,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(HighTmr.DN)OTE(HighAlarm);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[Motor_AOI(M1,Start_PB,Pump);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Pump OTE(x);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
